---
import "@fontsource/changa/400.css";
import "@fontsource/changa/600.css";
import "@fontsource/changa/700.css";
import "@fontsource/changa/800.css";
import "./styles.css";
import type { Tenant } from "../../lib/tenant";
interface Props { title: string; description?: string; image?: string; tenant: Tenant }
const { title, description = "", image, tenant } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const c = tenant.colors;
// Tenant identity flows into CSS as variables; everything else in styles.css
// keys off the body class (splash sequence, ring style, background images).
const vars = `--c-name:${c.name};--c-title:${c.title};--c-ph:${c.placeholder};--c-page:${c.page};--logo-h:${tenant.logoHeight}px`;
---
<!DOCTYPE html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {image && <meta property="og:image" content={image} />}
    {image && <meta property="og:image:width" content="820" />}
    {image && <meta property="og:image:height" content="900" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {image && <meta name="twitter:image" content={image} />}
    <meta name="theme-color" content={c.theme} />
  </head>
  <body class={`tenant-${tenant.id}`} style={vars}>
    <div class="splash" aria-hidden="true">
      <div class="splash__stack">
        <img class="splash__logo splash__logo--white" src={`${base}${tenant.assets}/logo-white.png`} alt="" />
        <img class="splash__logo splash__logo--color" src={`${base}${tenant.assets}/logo.png`} alt="" />
      </div>
    </div>
    <slot />
  </body>
</html>
