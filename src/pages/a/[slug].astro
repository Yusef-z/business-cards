---
import Layout from "../../designs/classic/Layout.astro";
import Card from "../../designs/classic/Card.astro";
import tenant from "../../../tenants/alawees/tenant.json";
import employees from "../../../tenants/alawees/employees.json";

export function getStaticPaths() {
  return employees.map((emp) => ({ params: { slug: emp.slug }, props: { emp } }));
}
const { emp } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// Per-person social-preview card (820x900), generated by scripts/make_og.py.
const image = Astro.site
  ? new URL(`${base}${tenant.assets}/og/${emp.slug}.png`, Astro.site).href
  : undefined;
---
<Layout title={emp.name} description={`${emp.name} — ${emp.org}`} image={image} tenant={tenant}>
  <Card emp={emp} tenant={tenant} />
</Layout>
