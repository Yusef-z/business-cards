---
import Layout from "../../designs/classic/Layout.astro";
import tenant from "../../../tenants/alawees/tenant.json";
import employees from "../../../tenants/alawees/employees.json";
import { initials } from "../../lib/employees.js";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<Layout title={`${tenant.org} — Team`} description={`${tenant.org} team directory`} tenant={tenant}>
  <section class="team">
    <img class="team__logo" src={base + tenant.directoryLogo} alt={tenant.org}
         onerror="this.style.display='none'" />
    <h1 class="team__heading">Our Team</h1>
    <ul class="team__grid">
      {employees.map((e) => (
        <li>
          <a class="tcard" href={`${base}${tenant.prefix}/${e.slug}`}>
            <span class="tcard__avatar">
              {e.photo ? <img src={base + e.photo} alt={e.name} /> : <span>{initials(e.name)}</span>}
            </span>
            <span class="tcard__name">{e.name}</span>
            <span class="tcard__title">{e.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>
